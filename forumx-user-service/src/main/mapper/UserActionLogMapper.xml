<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dlut.forumx.user.mapper.UserActionLogMapper">

    <!-- 实体映射 -->
    <resultMap id="BaseResultMap" type="com.dlut.forumx.user.entity.UserActionLog">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="user_id" property="userId" jdbcType="BIGINT"/>
        <result column="action_type" property="actionType" jdbcType="VARCHAR"/>
        <result column="target_id" property="targetId" jdbcType="VARCHAR"/>
        <result column="target_type" property="targetType" jdbcType="VARCHAR"/>
        <result column="extra_data" property="extraData" jdbcType="VARCHAR"/>
        <result column="ip_address" property="ipAddress" jdbcType="VARCHAR"/>
        <result column="user_agent" property="userAgent" jdbcType="VARCHAR"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
    </resultMap>

    <!-- 基础字段列表 -->
    <sql id="Base_Column_List">
        id, user_id, action_type, target_id, target_type, extra_data,
        ip_address, user_agent, create_time
    </sql>

    <!-- 插入日志 -->
    <insert id="insert" parameterType="com.dlut.forumx.user.entity.UserActionLog" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user_action_log (
            user_id, action_type, target_id, target_type, extra_data,
            ip_address, user_agent, create_time
        ) VALUES (
            #{userId}, #{actionType}, #{targetId}, #{targetType}, #{extraData},
            #{ipAddress}, #{userAgent}, NOW()
        )
    </insert>

    <!-- 查询用户日志 -->
    <select id="selectByUser" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM user_action_log
        WHERE user_id = #{userId}
        ORDER BY create_time DESC
        <if test="offset != null and limit != null">
            LIMIT #{offset}, #{limit}
        </if>
    </select>

    <!-- 根据操作类型查询日志 -->
    <select id="selectByAction" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM user_action_log
        WHERE action_type = #{actionType}
        ORDER BY create_time DESC
        <if test="offset != null and limit != null">
            LIMIT #{offset}, #{limit}
        </if>
    </select>

</mapper>
