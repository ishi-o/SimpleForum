<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dlut.forumx.user.mapper.UserTagMapper">

    <!-- 实体映射 -->
    <resultMap id="BaseResultMap" type="com.dlut.forumx.user.entity.UserTag">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="user_id" property="userId" jdbcType="BIGINT"/>
        <result column="tag_name" property="tagName" jdbcType="VARCHAR"/>
        <result column="tag_source" property="tagSource" jdbcType="TINYINT"/>
        <result column="weight" property="weight" jdbcType="INTEGER"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
    </resultMap>

    <!-- 基础字段列表 -->
    <sql id="Base_Column_List">
        id, user_id, tag_name, tag_source, weight, create_time, update_time
    </sql>

    <!-- 插入单个标签 -->
    <insert id="insert" parameterType="com.dlut.forumx.user.entity.UserTag" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user_tag (user_id, tag_name, tag_source, weight)
        VALUES (#{userId}, #{tagName}, #{tagSource}, #{weight})
    </insert>

    <!-- 批量插入标签 -->
    <insert id="batchInsert" parameterType="java.util.List">
        INSERT INTO user_tag (user_id, tag_name, tag_source, weight, create_time)
        VALUES
        <foreach collection="list" item="tag" separator=",">
            (#{tag.userId}, #{tag.tagName}, #{tag.tagSource}, #{tag.weight}, NOW())
        </foreach>
    </insert>

    <!-- 更新标签权重 -->
    <update id="updateWeight" parameterType="com.dlut.forumx.user.entity.UserTag">
        UPDATE user_tag
        SET weight = #{weight}
        WHERE user_id = #{userId} AND tag_name = #{tagName}
    </update>

    <!-- 删除用户的某个标签 -->
    <delete id="delete">
        DELETE FROM user_tag
        WHERE user_id = #{userId} AND tag_name = #{tagName}
    </delete>

    <!-- 删除用户所有标签 -->
    <delete id="deleteByUser">
        DELETE FROM user_tag
        WHERE user_id = #{userId}
    </delete>

    <!-- 查询用户的所有标签 -->
    <select id="selectByUser" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM user_tag
        WHERE user_id = #{userId}
        ORDER BY weight DESC
    </select>

    <!-- 查询用户的标签名称列表 -->
    <select id="selectTagNamesByUser" resultType="java.lang.String">
        SELECT tag_name
        FROM user_tag
        WHERE user_id = #{userId}
        ORDER BY weight DESC
    </select>

    <!-- 根据标签查询用户 -->
    <select id="selectByTag" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM user_tag
        WHERE tag_name = #{tagName}
        ORDER BY weight DESC
        LIMIT #{limit}
    </select>

</mapper>
